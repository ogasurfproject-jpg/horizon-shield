{
  // 2026-08-09 live照合済み。デプロイ可。
  // cron はダッシュボード実測: 0 3 1 * *（毎月1日 03:00）。
  // hs-internal-mcp からの Service バインディング経由の fetch も受けている。
  // APIFY_ACTOR_ID / APIFY_TOKEN / INGEST_SECRET は Secret。
  "name": "hs-genka-ingest",
  "main": "src/index.js",
  "compatibility_date": "2026-06-15",
  "triggers": { "crons": ["0 3 1 * *"] },
  "kv_namespaces": [
    { "binding": "GENKA_PENDING", "id": "84fd239f856943af8d0a5d8588422dd4" },
    { "binding": "GENKA_VERIFIED", "id": "6f3214d203b0443bbf051d07a56db52a" }
  ]
}
