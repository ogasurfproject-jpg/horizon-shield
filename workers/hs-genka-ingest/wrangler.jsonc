  "name": "hs-genka-ingest",
  "main": "src/index.js",
  "compatibility_date": "2026-06-15",
  "kv_namespaces": [
    { "binding": "GENKA_PENDING", "id": "84fd239f856943af8d0a5d8588422dd4" },
    { "binding": "GENKA_VERIFIED", "id": "6f3214d203b0443bbf051d07a56db52a" }
  ]
}
