{
  // Yakumo 検証の扉 / Verification Gate (v0 適合性チェッカー)
  // 独立worker。他サービスへの binding は持たない。
  // 判定は申請された URL を実測するだけで、当社の業務データには一切触れない。
  // これが「無料で開放できる」ことの技術的な裏づけ。
  //
  // KV を1つだけ持つ。用途は公開判定の履歴のみ。
  // 「測定が変われば緑ではなくなる」と公開ページに書いた以上、
  // 誰かが測り直して記録を残さねばならない。その置き場所。
  // 顧客データも申請者の秘密も入らない。入るのは既に公開されている判定だけ。
  "name": "hs-verify-gate",
  "main": "src/worker.js",
  // 2026-08-15 朝、同一ゾーン522の診断のために一時的に true にした
  // (workers.dev入口ならcron同様に通ることを実測し、中継設計の根拠になった)。
  // 診断は終わり、恒久対応は hs-verify-relay 経由。公開入口は custom domain 1本に戻す。
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "enabled": true } },
  "compatibility_date": "2024-01-01",

  // 毎日の再測定。UTC 18:00 = JST 翌03:00。負荷の薄い時間に置く。
  // 0.4.21 (2026-10-23). 1 時間おきに 4 回 (18:00, 19:00, 20:00, 21:00 UTC = JST 03:00〜06:00)。どの回も同じ掃引で、
  // その UTC 日に既に測った行は外すので、2 回目からは前の回の続きを測る。間隔を 1 時間以上にしたのは、Workers Paid の Cron の
  // CPU 上限が、間隔 1 時間以上の予定で 15 分、1 時間未満で 30 秒だから (https://developers.cloudflare.com/workers/platform/limits/)。
  // src/worker.js の SWEEP_CRONS と同じ並びでなければならない (test/sweep_stage2.test.mjs が縛る)。
  "triggers": {
    "crons": ["0 18 * * *", "0 19 * * *", "0 20 * * *", "0 21 * * *"]
  },

  "kv_namespaces": [
    { "binding": "HS_VERIFY_KV", "id": "ab98336fc22d4d0f947501d843d2d228" }
  ],

  // 2026-10-03. /ae/evaluate reads verify_fair_price receipts from hs-mcp (mcp.horizonshield.dev/ledger/<hash>).
  // hs-mcp is on a route in the same zone, so a plain fetch from this Worker never arrives; it needs a binding.
  "services": [
    { "binding": "MCP_SVC", "service": "hs-mcp" }
  ],

  // 2026-10-13 (concurrency audit G4, G5). 掃引の単走の lease。一度に走る掃引は一本(cron 18:00Z と運営の POST /sweep)。
  // 中身は src/sweep_lease.js(worker.js から re-export)。顧客データは入らん。入るのは「いま誰が掃引中か」の一行だけ。
  // この binding が無いと掃引は従来どおり lease 無しで走る(単体試験、GCP の双子)。
  "durable_objects": {
    "bindings": [
      { "name": "SWEEP_LEASE_DO", "class_name": "SweepLeaseDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SweepLeaseDO"] }
  ],

  // 同一ゾーン522の迂回先。RELAY_TOKEN は secret で入れる:
  //   npx wrangler secret put RELAY_TOKEN
  // 中継側(hs-verify-relay)にも同じ値を入れる。片方だけだと 403 で
  // 「relay unavailable: gate-side failure」が判定に出る(相手の記録にはならない)。
  //
  // 2026-08-21: workers.dev から別ゾーンのカスタムドメインへ変更。
  //   旧 hs-verify-relay.oga-surf-project.workers.dev は同一アカウント workers.dev 間
  //   subrequest を Cloudflare に塞がれ、cron の自己測定が http 404 で pending になっていた。
  //   relay を the-horizons-innovation.com(別ゾーン)に置き、ここをそのまま指す。
  // 0.4.23: Microsoft Marketplace の毎日の一覧。扉が cron の掃引で読むのは、secret の MARKETPLACE_DAILY_TOKEN もある時だけ
  //   (hs-ms-marketplace の DAILY_READ_TOKEN と同じ値。GET /admin/daily だけを開ける鍵): npx wrangler secret put MARKETPLACE_DAILY_TOKEN
  // REPLICA_ORIGIN は、写しが自分の origin で答えるようになるまでここに置かない。
  "vars": {
    "RELAY_URL": "https://horizon-shield.ogasurfproject-jpg.deno.net",
    "MARKETPLACE_DAILY_URL": "https://marketplace.horizonshield.dev/admin/daily"
  }
}