{
  "name": "nenrin-verify",
  "version": "0.2.2",
  "description": "Single-file, zero-dependency, consumer-runnable verifiers for NENRIN evidence: a provenance bundle (nenrin_verify.mjs) and a TSUGI recovery chain with its random witness draw (tsugi_verify.mjs). Verify yourself, offline, with no trust in the operator.",
  "type": "module",
  "main": "nenrin_verify.mjs",
  "exports": {
    ".": "./nenrin_verify.mjs",
    "./tsugi": "./tsugi_verify.mjs"
  },
  "bin": {
    "nenrin-verify": "nenrin_verify.mjs",
    "tsugi-verify": "tsugi_verify.mjs"
  },
  "files": [
    "nenrin_verify.mjs",
    "tsugi_verify.mjs",
    "SDK.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "a2a",
    "provenance",
    "verification",
    "did-key",
    "ed25519",
    "nenrin",
    "agent",
    "evidence",
    "bitcoin",
    "trust",
    "horizon-shield",
    "recovery",
    "tsugi",
    "witness",
    "random-draw",
    "commit-reveal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogasurfproject-jpg/horizon-shield.git",
    "directory": "workers/hs-ledger/nenrin/sdk"
  },
