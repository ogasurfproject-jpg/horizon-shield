{
  // hs-ledger — JIDEC public verification ledger
  //
  // ★2026-07-26 修正（看板v1.1 と同じ一手）:
  //   このファイルは長らく「初回デプロイ用の空欄つきメモ」のままだった。
  //   本番の hs-ledger には (a) 実物の KV 名前空間 (b) hs-pdf-gen への
  //   PDF_GEN サービスバインディング が既に載っているのに、ここには
  //   どちらも書かれていなかった。
  //
  //   このまま `npx wrangler deploy` すると **PDF_GEN バインディングが消える**。
  //   消えても派手には壊れない。replay が hs-pdf-gen ノードを再観測できなくなり、
  //   そのノードが deferred に落ちるだけである。deferred はドリフト扱いしない
  //   設計なので、台帳は「異常なし」と言い続ける。**静かに検証能力だけが減る**。
  //   これは JIDEC にとって最も質の悪い壊れ方なので、先に埋めた。
  //
  //   同じ理由で account_id と workers_dev も明示した。いずれも実測値である
  //   （KV id: kv_namespaces_list / サービス名: workers_list / 2026-07-26）。
  //
  // 秘密はこのファイルに書かない。LEDGER_ADMIN_TOKEN は wrangler secret 側にあり、
  // secret は deploy で消えない。消えるのは平文 vars とバインディングである。
  //
  // デプロイ前に必ず: node test/ledger.test.mjs && node test/mcp.test.mjs
  "name": "hs-ledger",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-18",
  "account_id": "c15ff64aba400e541853dec1fbe5e76a",
  "workers_dev": true,
  "kv_namespaces": [
    { "binding": "LEDGER", "id": "37f6ebec621e42e9b9d6362ef6114e78" }
  ],
  "services": [
    // 第二の掟：同一アカウントの workers.dev を fetch すると自分に戻ってくる。
    // 過去にこれで FALSE DRIFT を出した。だから公開URLではなくバインディングで呼ぶ。
    { "binding": "PDF_GEN", "service": "hs-pdf-gen" }
  ],
  // ★2026-07-26 追加：看板の実測。
  //   dataset はこの deploy で自動的に作られる。事前に作る操作は要らない。
  //   バインディング名を変えるとコード側の env.KANBAN_AE と外れ、計測が
  //   **黙って止まる**（コードは何も投げない設計なので誰も気づかない）。
  //   名前を変えるなら src/worker.js の noteHit も一緒に変えること。
  //   読み出しは Cloudflare 側（GraphQL / SQL API）で行う。Worker には
  //   読み出しルートを一切足していない。足せばアカウント用のAPIトークンを
  //   Worker に持たせることになり、公開台帳が持つべきでない秘密が増える。
  "analytics_engine_datasets": [
    { "binding": "KANBAN_AE", "dataset": "hs_ledger_kanban" }
  ]
  // PENDING_STALE_HOURS は任意。未設定なら STALE_HOURS_DEFAULT=6 が効く。
  // ダッシュボードで設定していた場合、vars を宣言しない deploy で消える点に注意
  // （消えても既定値6に戻るだけで、壊れはしない）。
}
