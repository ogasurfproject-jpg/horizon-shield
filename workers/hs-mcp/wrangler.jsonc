{
  // hs-mcp : HORIZON SHIELD MCP server (独立ワーカー / kira-proxy非依存)
  "name": "hs-mcp",
  "main": "src/mcp.js",
  "compatibility_date": "2025-06-01",

  // ★2026-08-14 第3段。wrangler がダッシュボード側を黙って上書きするのを塞ぐ。
  //   §19.3 の実測: このファイルに書いていない項目は、ローカルの既定値で
  //   リモートを上書きされる。hs-followup では observability が true->false に
  //   落ちかけた(ログが切れる)。対策済みの5本に hs-mcp が入っていなかったので揃える。
  //   workers_dev はここでは触らない。上の理由(掲載・キャッシュ・ブックマーク)がある。
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "enabled": true } },
  // ★2026-08-11 第1段。現在の状態を明文化するだけで、何も変えない。
  //   このファイルには workers_dev の記述が無かった。wrangler は routes が
  //   書かれていない限り workers_dev を true とみなすので、現状は true。
  //   つまりこの行は「今そうなっていること」を書いただけである。
  //
  //   先に固定しておく理由: routes を足すと wrangler は workers_dev の既定を
  //   false に切り替える。routes と workers_dev を同じデプロイで初めて触ると、
  //   その相互作用が本番で一度きり発生する。先にこちらを明示しておけば、
  //   相互作用そのものが起こり得なくなる。
  //
  //   hs-mcp.oga-surf-project.workers.dev はまだ mcpservers.org の掲載・
  //   Glamaのキャッシュ・利用者のブックマークが指している。落とせない。
  "workers_dev": true,

  "kv_namespaces": [
    {
      "binding": "RL_KV",
      "id": "1bf80c9f870f403ea93d2eec90a7402e"
    }
  ],

  // ★2026-09-13 patch3。find_verified_contractor が hs-hearing の公開ライブ名簿(/contractors.json)を読む道。
  //   mcp.horizonshield.dev も hearing.horizonshield.dev も同じ zone の Route なので、Worker から
  //   公開 hostname 経由の fetch は通らん(本番実測: 静的 JSON に落ちとった)。hs-jidec-mcp -> hs-ledger と同じ形。
  "services": [
    { "binding": "HEARING_SVC", "service": "hs-hearing" },
    // ★2026-09-26 JCCDB の品目・観測層 v2 の口(11本: search_jccdb_items / get_jccdb_observations / get_jccdb_labor_rate /
    //   compare_jccdb_regions / get_jccdb_work_unit_price / get_jccdb_index_series / get_us_construction_prices / get_jccdb_coverage /
    //   get_us_prevailing_wage / get_us_permits / get_us_area_factor)。
    //   同じ夜の v3 で、米国の掛け率の層の 4 本(get_us_price_chain / get_us_import_landed_cost / get_us_trade_margins /
    //   get_us_contract_discounts)もこの口を通る。hs-jccdb-obs は内部の口(jccdb-obs.internal)から来た問い合わせにだけ米国の値を返すので、
    //   この binding が無いと 4 本は値を返さない。
    //   hs-jccdb-obs を先に deploy してから、この行を含む hs-mcp を deploy する(逆順だと binding 先が無く deploy が落ちる)。
    { "binding": "JCCDB_SVC", "service": "hs-jccdb-obs" }
  ],

  // ★2026-08-11 第2段。mcp.horizonshield.dev をリポジトリから再現可能にする。
  //   これも現状を書き写すだけで、稼働中のものは変えない。
  //
  //   形式に注意: この hostname は Custom Domain ではなく Zone Route である
  //   (Domains タブの実物確認)。ledger / jidec が使う custom_domain:true を
  //   ここに書くと、生きている Route を別形式へ変換しにいく。同じ形で書く。
  //   zone_id は horizonshield.dev の Overview / API パネルの実測値。
  //
  //   ★このリストは wrangler にとって「正」である。ここに書かなかったルートは
  //     消える。追加・削除する時は必ず Domains タブの全行と突き合わせること。
  //     2026-08-11 時点の実測はこの1件のみ。
  "routes": [
    { "pattern": "mcp.horizonshield.dev/*", "zone_id": "3cfbb072435b7010cc98dce59d0b82e5" }
  ]
}
